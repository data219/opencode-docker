// opencode-docker-config:1
// OpenAI ChatGPT subscription variant.
// Auth is handled by OpenCode's built-in OpenAI OAuth/device-login flow, not by OPENAI_API_KEY.
// GPT-6 Sol is the quota-conscious workhorse; Luna low handles research and quick tasks.
// Astra is reserved for oracle high, momus/deep-high xhigh, and ultrabrain max.
// Standard models intentionally avoid Fast/priority quota premiums. See README for the
// exact OmO 5.0.1 default comparison and rationale for OpenAI-only overrides.
// Fallbacks are degraded service: Astra -> Sol -> Luna; Sol -> Luna; Luna -> Sol.
// Retired ChatGPT-sign-in models (GPT-5.4, mini, and Spark) are not fallback options.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/ab725f3299cd5ba8727a999817db8f9d856f2440/assets/omo.schema.json",
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-6-sol",
        "variant": "medium",
        "fallback_models": [
          "openai/gpt-6-luna"
        ],
        "prompt_append": "Avoid long silent polling. Do not run sleeps longer than 30 seconds or multi-minute wait loops. For external review/CI waits, use bounded short polling with narrow JSON/JQ fields, persist pending state with the next exact poll command, and stop cleanly instead of calling it a harness interruption."
      },
      "hephaestus": {
        "model": "openai/gpt-6-sol",
        "variant": "medium",
        "fallback_models": [
          "openai/gpt-6-luna"
        ],
        "prompt_append": "Follow established plans precisely. Ask for clarification when plans are ambiguous. Prefer small, testable changes. Use LSP and AST-grep aggressively."
      },
      "prometheus": {
        "model": "openai/gpt-6-sol",
        "variant": "high",
        "fallback_models": [
          "openai/gpt-6-luna"
        ],
        "prompt_append": "Always interview first. Validate scope before planning. Build exhaustive plans with milestones, risks, and contingencies. Max 2 parallel background tasks."
      },
      "metis": {
        "model": "openai/gpt-6-sol",
        "variant": "high",
        "fallback_models": [
          "openai/gpt-6-luna"
        ],
        "prompt_append": "Critically evaluate plans. Identify gaps, risks, and improvements. Be thorough."
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "variant": "high",
        "fallback_models": [
          "openai/gpt-6-sol",
          "openai/gpt-6-luna"
        ]
      },
      "momus": {
        "model": "openai/gpt-6-astra",
        "variant": "xhigh",
        "fallback_models": [
          "openai/gpt-6-sol",
          "openai/gpt-6-luna"
        ],
        "prompt_append": "Challenge all assumptions in plans. Look for edge cases, failure modes, and overlooked requirements."
      },
      "atlas": {
        "model": "openai/gpt-6-sol",
        "variant": "medium",
        "fallback_models": [
          "openai/gpt-6-luna"
        ]
      },
      "sisyphus-junior": {
        "model": "openai/gpt-6-sol",
        "fallback_models": [
          "openai/gpt-6-luna"
        ],
        "variant": "medium"
      },
      "explore": {
        "model": "openai/gpt-6-luna",
        "variant": "low",
        "fallback_models": [
          "openai/gpt-6-sol"
        ],
        "prompt_append": "Prefer searching official documentation and library sources over general web search."
      },
      "librarian": {
        "model": "openai/gpt-6-luna",
        "variant": "low",
        "fallback_models": [
          "openai/gpt-6-sol"
        ],
        "prompt_append": "Focus on finding authoritative sources. Cross-reference results when possible. Keep research brief and decision-oriented: return only the facts needed for the current task, cite sources, and avoid exhaustive result dumps or broad background unless explicitly requested. Prefer a short answer with 3-5 high-signal bullets over long summaries."
      },
      "multimodal-looker": {
        "model": "openai/gpt-6-sol",
        "variant": "low",
        "fallback_models": [
          "openai/gpt-6-luna"
        ]
      }
    },
    "categories": {
      "ultrabrain": {
        "model": "openai/gpt-6-astra",
        "variant": "max",
        "fallback_models": [
          "openai/gpt-6-sol",
          "openai/gpt-6-luna"
        ]
      },
      "visual-engineering": {
        "model": "openai/gpt-6-sol",
        "variant": "high",
        "fallback_models": [
          "openai/gpt-6-luna"
        ]
      },
      "unspecified-high": {
        "model": "openai/gpt-6-sol",
        "variant": "high",
        "fallback_models": [
          "openai/gpt-6-luna"
        ]
      },
      "deep-low": {
        "model": "openai/gpt-6-sol",
        "variant": "medium",
        "fallback_models": [
          "openai/gpt-6-luna"
        ]
      },
      "deep-high": {
        "model": "openai/gpt-6-astra",
        "variant": "xhigh",
        "fallback_models": [
          "openai/gpt-6-sol",
          "openai/gpt-6-luna"
        ]
      },
      "writing": {
        "model": "openai/gpt-6-sol",
        "variant": "medium",
        "fallback_models": [
          "openai/gpt-6-luna"
        ]
      },
      "quick": {
        "model": "openai/gpt-6-luna",
        "variant": "low",
        "fallback_models": [
          "openai/gpt-6-sol"
        ]
      },
      "unspecified-low": {
        "model": "openai/gpt-6-sol",
        "variant": "high",
        "fallback_models": [
          "openai/gpt-6-luna"
        ]
      },
      "artistry": {
        "model": "openai/gpt-6-sol",
        "variant": "xhigh",
        "fallback_models": [
          "openai/gpt-6-luna"
        ]
      }
    },
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        503,
        529
      ],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 60
    },
    "default_mode": {
      "ultrawork": true,
      "goal": true
    },
    "goal": {
      "enabled": true
    },
    "background_task": {
      "staleTimeoutMs": 5400000,
      "messageStalenessTimeoutMs": 7200000,
      "taskTtlMs": 7200000,
      "sessionGoneTimeoutMs": 180000,
      "providerConcurrency": {
        "openai": 3
      },
      "modelConcurrency": {
        "openai/gpt-6-astra": 1,
        "openai/gpt-6-sol": 2,
        "openai/gpt-6-luna": 2
      }
    },
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 4,
      "max_members": 8,
      "tmux_visualization": false
    },
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": true
    },
    "sisyphus_agent": {
      "planner_enabled": true,
      "replace_plan": true
    },
    "hashline_edit": true,
    "experimental": {
      "aggressive_truncation": false,
      "task_system": true
    }
  }
}
