// opencode-docker-config:1
// OpenAI ChatGPT subscription variant; authenticate inside the pinned OpenCode V1 container.
// Standard GPT-6.1 Sol, GPT-6 Astra and GPT-6 Luna only. See docs/openai-model-map.md.
// Explicit model chains apply to delegated tasks; main agents stop on model errors.
// Inline fallback reasoning avoids OmO 5.1.29 losing reasoning from fallback objects.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/6dfb41974556051b432c30ed71b134ed826c883a/assets/omo.schema.json",
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "medium"
          },
          "openai/gpt-6-luna:medium"
        ],
        "prompt_append": "Avoid long silent polling. Do not run sleeps longer than 30 seconds or multi-minute wait loops. For external review/CI waits, use bounded short polling with narrow JSON/JQ fields, persist pending state with the next exact poll command, and stop cleanly instead of calling it a harness interruption."
      },
      "hephaestus": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "medium"
          },
          "openai/gpt-6-luna:medium"
        ],
        "prompt_append": "Follow established plans precisely. Ask for clarification when plans are ambiguous. Prefer small, testable changes. Use LSP and AST-grep aggressively."
      },
      "prometheus": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          "openai/gpt-6-luna:high"
        ],
        "prompt_append": "Always interview first. Validate scope before planning. Build exhaustive plans with milestones, risks, and contingencies. Max 2 parallel background tasks."
      },
      "metis": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          "openai/gpt-6-luna:high"
        ],
        "prompt_append": "Critically evaluate plans. Identify gaps, risks, and improvements. Be thorough."
      },
      "oracle": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          "openai/gpt-6-luna:high"
        ]
      },
      "momus": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "reasoning": "xhigh"
          },
          "openai/gpt-6.1-sol:xhigh",
          "openai/gpt-6-luna:xhigh"
        ],
        "prompt_append": "Challenge all assumptions in plans. Look for edge cases, failure modes, and overlooked requirements."
      },
      "atlas": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "medium"
          },
          "openai/gpt-6-luna:medium"
        ]
      },
      "sisyphus-junior": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "medium"
          },
          "openai/gpt-6-luna:medium"
        ]
      },
      "explore": {
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "low"
          },
          "openai/gpt-6.1-sol:low"
        ],
        "prompt_append": "Prefer searching official documentation and library sources over general web search."
      },
      "librarian": {
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "high"
          },
          "openai/gpt-6.1-sol:high"
        ],
        "prompt_append": "Focus on finding authoritative sources. Cross-reference results when possible. Keep research brief and decision-oriented: return only the facts needed for the current task, cite sources, and avoid exhaustive result dumps or broad background unless explicitly requested. Prefer a short answer with 3-5 high-signal bullets over long summaries."
      },
      "multimodal-looker": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "low"
          },
          "openai/gpt-6-luna:low"
        ]
      }
    },
    "categories": {
      "ultrabrain": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "reasoning": "max"
          },
          "openai/gpt-6.1-sol:max",
          "openai/gpt-6-luna:max"
        ]
      },
      "visual-engineering": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          "openai/gpt-6-luna:high"
        ]
      },
      "unspecified-high": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "high"
          },
          "openai/gpt-6-luna:high"
        ]
      },
      "deep-low": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "medium"
          },
          "openai/gpt-6-luna:medium"
        ]
      },
      "deep-high": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "reasoning": "high"
          },
          "openai/gpt-6.1-sol:high",
          "openai/gpt-6-luna:high"
        ]
      },
      "writing": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "medium"
          },
          "openai/gpt-6-luna:medium"
        ]
      },
      "quick": {
        "models": [
          {
            "model": "openai/gpt-6-luna",
            "reasoning": "low"
          },
          "openai/gpt-6.1-sol:low"
        ]
      },
      "unspecified-low": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "medium"
          },
          "openai/gpt-6-luna:medium"
        ]
      },
      "artistry": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "xhigh"
          },
          "openai/gpt-6-luna:xhigh"
        ]
      }
    },
    "runtime_fallback": {
      "enabled": false
    },
    "default_mode": {
      "ultrawork": true,
      "goal": true
    },
    "goal": {
      "enabled": true
    },
    "background_task": {
      "staleTimeoutMs": 5400000,
      "messageStalenessTimeoutMs": 7200000,
      "taskTtlMs": 7200000,
      "sessionGoneTimeoutMs": 180000,
      "providerConcurrency": {
        "openai": 3
      },
      "modelConcurrency": {
        "openai/gpt-6.1-sol": 2,
        "openai/gpt-6-astra": 1,
        "openai/gpt-6-luna": 2
      }
    },
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 4,
      "max_members": 8,
      "tmux_visualization": false
    },
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": true
    },
    "sisyphus_agent": {
      "planner_enabled": true,
      "replace_plan": true
    },
    "hashline_edit": true,
    "experimental": {
      "aggressive_truncation": false,
      "task_system": true
    },
    "model_fallback": false
  }
}
